---
// website/src/components/Hero.astro
import InstallRows from './InstallRows.astro';
---

<section class="c9-hero">
    <img
        src="/icon-160.webp"
        alt="c9watch"
        width="80"
        height="80"
        class="hero-icon"
    />
    <h1 class="hero-title">
        Five agents running. One is stuck on a permission prompt. Which one?
    </h1>
    <p class="hero-sub">c9watch finds every Claude Code, Codex, Cursor Agent and Pi session on your Mac. Ghostty, iTerm2, VS Code, tmux: it doesn't matter where you started them. The one waiting for you goes to the top.</p>
    <div class="hero-cta">
        <InstallRows />
    </div>
    <p class="hero-meta">macOS app · CLI for macOS & Linux · MIT · <a href="/changelog/">v0.10.0</a></p>
    <div class="hero-demo">
        <video autoplay loop muted playsinline>
            <source src="/screenshots/demo.mp4" type="video/mp4" />
        </video>
    </div>
</section>

<style>
    .c9-hero {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 5rem 2rem 4rem;
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .hero-icon {
        border-radius: 16px;
        margin-bottom: 2rem;
        border: none !important;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        max-width: 640px;
        margin-bottom: 1.25rem;
    }

    .hero-sub {
        color: var(--text-secondary);
        font-size: 16px;
        line-height: 1.5;
        max-width: 560px;
        margin: 0 0 2rem;
    }

    .hero-cta {
        width: 100%;
        margin-bottom: 1.5rem;
    }

    .hero-meta {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 3rem;
    }

    .hero-meta a {
        color: var(--text-secondary);
    }

    .hero-demo {
        width: 100%;
        max-width: 720px;
        border: 1px solid var(--border-default);
    }

    .hero-demo video {
        width: 100%;
        display: block;
    }

    @media (max-width: 640px) {
        .c9-hero {
            padding: 3rem 1rem 3rem;
        }

        .hero-title {
            font-size: 1.75rem;
        }
    }
</style>
