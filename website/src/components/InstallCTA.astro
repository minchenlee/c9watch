---
// website/src/components/InstallCTA.astro
import InstallRows from './InstallRows.astro';
---

<section class="cta">
  <h2 class="cta-heading">Get started</h2>
  <InstallRows cli />
  <a href="https://github.com/minchenlee/c9watch/releases" class="cta-releases" target="_blank" rel="noopener">
    Or download from GitHub Releases
  </a>
</section>

<style>
  .cta {
    padding: 4rem 1.5rem;
    text-align: center;
    border-top: 1px solid var(--border-muted);
  }

  .cta-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .cta-releases {
    display: block;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cta-releases:hover {
    color: var(--text-secondary);
  }
</style>
