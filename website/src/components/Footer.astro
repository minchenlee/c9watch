---
// website/src/components/Footer.astro
// LED-board footer: one canvas of square pixels. The c9watch wordmark is made of brighter
// cells; status colours (Working, Needs Attention, Ready) tick across the whole panel.
const links = [
  { label: 'Install', href: '/install/' },
  { label: 'Features', href: '/features/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Compatibility', href: '/compatibility/' },
  { label: 'GitHub', href: 'https://github.com/minchenlee/c9watch', external: true },
  { label: 'MIT', href: 'https://github.com/minchenlee/c9watch/blob/main/LICENSE', external: true },
  { label: '@minchenlee', href: 'https://github.com/minchenlee', external: true },
];
---

<footer class="term">
  <div class="term-pad term-bar">
    <span>c9watch: every agent session, one dashboard</span>
    <span aria-hidden="true">[EOF]</span>
  </div>
  <div class="term-panel">
    <canvas class="term-canvas" role="img" aria-label="c9watch"></canvas>
  </div>
  <ul class="term-pad term-meta">
    {links.map((l) => (
      <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
    ))}
    <li>Also by the author: <a href="https://rmdv.mclee.dev" target="_blank" rel="noopener">rmdv</a></li>
  </ul>
</footer>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.term-canvas');
  const panel = canvas?.parentElement;
  if (canvas && panel) {
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;

    // 5-wide glyphs; c, w, a have 5 rows and sit on the baseline of the 7-row grid.
    const FONT: Record<string, string[]> = {
      c: ['.###.', '#...#', '#....', '#...#', '.###.'],
      '9': ['.###.', '#...#', '#...#', '.####', '....#', '#...#', '.###.'],
      w: ['#...#', '#...#', '#.#.#', '#.#.#', '.#.#.'],
      a: ['.###.', '....#', '.####', '#...#', '.####'],
      t: ['.#...', '.#...', '####.', '.#...', '.#...', '.#..#', '..##.'],
      h: ['#....', '#....', '####.', '#...#', '#...#', '#...#', '#...#'],
    };
    const WORD = 'c9watch';
    const GLYPH_ROWS = 7;
    const base = WORD.split('').map((ch) => {
      const g = FONT[ch];
      return [...Array(GLYPH_ROWS - g.length).fill('.....'), ...g];
    });
    const word = Array.from({ length: GLYPH_ROWS }, (_, r) => base.map((g) => g[r]).join('.'));
    const WORD_COLS = word[0].length; // 41

    // App status tokens: Working, Needs Attention, Ready
    const STATUS: [number, number, number][] = [[121, 40, 202], [255, 102, 0], [0, 255, 136]];
    const BG = 20;          // dark cell grey level
    const INK = 66;         // wordmark cell grey level
    const WIND_BG = 5;      // +- grey levels of the wind on background cells
    const WIND_INK = 3;     // +- grey levels of the wind on wordmark cells
    const FRAME_MS = 33;
    const WIND_X = 1, WIND_Y = 0.35; // drift direction (cells per second scale below)

    let S = 7, GAP = 1, P = 8;
    let cols = 0, rows = 0, offX = 0, W = 0, H = 0;
    let isWord: Uint8Array;
    let glow: Float32Array;       // 0..1 status-colour intensity, decays per cell
    let hue: Uint8Array;          // status index per cell
    let rate: Float32Array;       // decay per ms per cell (1 / 600..1500 ms)
    let ghost: Float32Array;      // 0..1 grey lift from ghosting / scan line
    let wordIdx: number[] = [];
    let sparks: { x: number; y: number; vx: number; vy: number; born: number; life: number; c: number }[] = [];
    let scan: { start: number; dur: number } | null = null;
    let nextSpark = 0, nextGhost = 0;
    let timer = 0, lastDraw = 0, lastFrame = 0;
    let perfSum = 0, perfN = 0, perfMax = 0;

    function layout() {
      const w = panel!.clientWidth;
      const small = w <= 640;
      S = small ? 5 : 7;
      GAP = 1;
      P = S + GAP;
      cols = Math.floor((w + GAP) / P);
      const k = Math.max(1, Math.floor(cols / WORD_COLS)); // cells per stroke
      const wordW = WORD_COLS * k, wordH = GLYPH_ROWS * k;
      const margin = small ? 3 : 5;
      rows = wordH + margin * 2;
      W = w;
      H = rows * P - GAP;
      offX = (w - (cols * P - GAP)) / 2;
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      canvas!.dataset.cell = `${S}`;
      canvas!.dataset.grid = `${cols}x${rows}`;

      const n = cols * rows;
      isWord = new Uint8Array(n);
      wordIdx = [];
      const x0 = Math.floor((cols - wordW) / 2), y0 = margin;
      for (let r = 0; r < GLYPH_ROWS; r++) {
        for (let c = 0; c < WORD_COLS; c++) {
          if (word[r][c] !== '#') continue;
          for (let dy = 0; dy < k; dy++) {
            for (let dx = 0; dx < k; dx++) {
              const i = (y0 + r * k + dy) * cols + (x0 + c * k + dx);
              isWord[i] = 1;
              wordIdx.push(i);
            }
          }
        }
      }
      glow = new Float32Array(n);
      hue = new Uint8Array(n);
      rate = new Float32Array(n);
      ghost = new Float32Array(n);
      sparks = [];
      scan = null;
    }

    function ignite(i: number, amount: number, color: number) {
      if (i < 0 || i >= glow.length) return;
      if (amount > glow[i]) {
        glow[i] = amount;
        hue[i] = color;
        rate[i] = 1 / (600 + Math.random() * 900);
      }
    }

    // Drifting wind: two slow diagonal waves, 0..1
    function wind(c: number, r: number, t: number) {
      return 0.5 + 0.28 * Math.sin(c * 0.07 + r * 0.11 - t * 0.0006)
                 + 0.22 * Math.sin(c * 0.031 - r * 0.07 - t * 0.00037 + 1.7);
    }

    function step(now: number, dt: number) {
      // decay glow + ghost
      for (let i = 0; i < glow.length; i++) {
        if (glow[i] > 0) glow[i] = Math.max(0, glow[i] - rate[i] * dt);
        if (ghost[i] > 0) ghost[i] = Math.max(0, ghost[i] - dt / 600);
      }
      // sparks spawn near the wordmark and drift with the wind
      if (now >= nextSpark) {
        nextSpark = now + 180 + Math.random() * 320;
        if (sparks.length < 16) {
          const i = wordIdx[(Math.random() * wordIdx.length) | 0];
          sparks.push({
            x: i % cols, y: Math.floor(i / cols),
            vx: (WIND_X * (0.5 + Math.random() * 0.7)) * 0.006,
            vy: (WIND_Y * (Math.random() - 0.3)) * 0.006,
            born: now, life: 1800 + Math.random() * 1800,
            c: (Math.random() * STATUS.length) | 0,
          });
        }
      }
      sparks = sparks.filter((s) => {
        const age = now - s.born;
        if (age > s.life) return false;
        s.x += s.vx * dt; s.y += s.vy * dt;
        const e = Math.sin((age / s.life) * Math.PI); // fade in, fade out
        const cx = Math.round(s.x), cy = Math.round(s.y);
        if (cx >= 0 && cx < cols && cy >= 0 && cy < rows) {
          const i = cy * cols + cx;
          ignite(i, (isWord[i] ? 0.9 : 0.6) * e, s.c);
        }
        return true;
      });
      // occasional ghosting: shifted afterimage chunk, or a short scan line
      if (now >= nextGhost) {
        nextGhost = now + 2500 + Math.random() * 3500;
        if (Math.random() < 0.5) {
          scan = { start: now, dur: 900 };
        } else {
          const n = 1 + ((Math.random() * 2) | 0);
          for (let m = 0; m < n; m++) {
            const i0 = wordIdx[(Math.random() * wordIdx.length) | 0];
            const off = Math.random() < 0.5 ? -1 : 1;
            for (let j = 0; j < 7; j++) {
              const i = i0 + j;
              if (isWord[i] && Math.floor(i / cols) === Math.floor(i0 / cols)) {
                const g = i + off * (1 + ((Math.random() * 2) | 0));
                if (g >= 0 && g < ghost.length && !isWord[g]) ghost[g] = Math.max(ghost[g], 0.5);
              }
            }
          }
        }
      }
      if (scan) {
        const p = (now - scan.start) / scan.dur;
        if (p >= 1) scan = null;
        else {
          const c = Math.floor(p * (cols + 6)) - 3;
          for (let r = 0; r < rows; r++) {
            for (let d = 0; d < 2; d++) {
              const cc = c - d;
              if (cc < 0 || cc >= cols) continue;
              const i = r * cols + cc;
              if (isWord[i]) ghost[i] = Math.max(ghost[i], d === 0 ? 0.55 : 0.3);
            }
          }
        }
      }
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, W, H);
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c;
          const w = isWord[i];
          const wv = wind(c, r, now) - 0.5;
          let g = (w ? INK : BG) + wv * 2 * (w ? WIND_INK : WIND_BG) + ghost[i] * 30;
          let cr = g, cg = g, cb = g;
          const a = glow[i];
          if (a > 0) {
            const k = a * a * (3 - 2 * a) * (w ? 1 : 0.7); // smooth ease, status colour -> cell base
            const s = STATUS[hue[i]];
            cr += (s[0] - cr) * k; cg += (s[1] - cg) * k; cb += (s[2] - cb) * k;
          }
          ctx.fillStyle = `rgb(${cr | 0},${cg | 0},${cb | 0})`;
          ctx.fillRect(offX + c * P, r * P, S, S);
        }
      }
    }

    function frame(now: number) {
      timer = requestAnimationFrame(frame);
      if (now - lastDraw < FRAME_MS) return;
      const t0 = performance.now();
      const dt = Math.min(100, lastFrame ? now - lastFrame : FRAME_MS);
      lastFrame = now; lastDraw = now;
      step(now, dt);
      draw(now);
      const cost = performance.now() - t0;
      perfSum += cost; perfN++; perfMax = Math.max(perfMax, cost);
      canvas!.dataset.perf = `${(perfSum / perfN).toFixed(2)}ms avg, ${perfMax.toFixed(2)}ms max, n=${perfN}`;
    }

    function staticFrame() {
      const now = 4000;
      [0.12, 0.31, 0.5, 0.68, 0.87].forEach((f, n) => {
        ignite(wordIdx[Math.floor(f * wordIdx.length)], 0.9, n % STATUS.length);
      });
      draw(now);
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;
    const sync = () => {
      const run = !reduced && inView && !document.hidden;
      if (run && !timer) { lastFrame = 0; timer = requestAnimationFrame(frame); }
      if (!run && timer) { cancelAnimationFrame(timer); timer = 0; }
    };

    layout();
    if (reduced) staticFrame(); else draw(performance.now());

    // Keep bitmap size, grid and CSS size in sync when the panel width changes (same fix as DotGrid).
    let lastW = panel.clientWidth;
    let resizeTimer: ReturnType<typeof setTimeout>;
    new ResizeObserver(() => {
      if (panel.clientWidth === lastW) return;
      lastW = panel.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        layout();
        if (reduced) staticFrame(); else draw(performance.now());
      }, 100);
    }).observe(panel);

    if (!reduced) {
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.1 }).observe(panel);
      document.addEventListener('visibilitychange', sync);
    }
  }
</script>

<style>
  .term {
    background: var(--bg-elevated, #0a0a0a);
    border-top: 1px solid var(--border-muted);
    padding: var(--section-y) 0 2.5rem;
    font-family: var(--font-mono);
  }

  .term-pad {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: content-box;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .term-bar span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-panel {
    width: 100%;
    margin: 1rem 0 1.75rem;
    line-height: 0;
  }

  .term-canvas {
    display: block;
  }

  .term-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    margin-top: 0;
    margin-bottom: 0;
    list-style: none;
    font-size: 12px;
    color: var(--text-muted);
  }

  .term-meta li {
    margin: 0;
    padding: 0;
  }

  .term-meta a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .term-meta a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .term-pad {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
