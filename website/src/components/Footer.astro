---
// website/src/components/Footer.astro
// Terminal-style closing block. Glyphs tick in the app's status colours while in view.
// 5-wide pixel glyphs. x-height letters (c, w, a) have 5 rows and sit on the baseline of the 7-row grid.
const FONT: Record<string, string[]> = {
  c: ['.###.', '#...#', '#....', '#...#', '.###.'],
  '9': ['.###.', '#...#', '#...#', '.####', '....#', '#...#', '.###.'],
  w: ['#...#', '#...#', '#.#.#', '#.#.#', '.#.#.'],
  a: ['.###.', '....#', '.####', '#...#', '.####'],
  t: ['.#...', '.#...', '####.', '.#...', '.#...', '.#..#', '..##.'],
  h: ['#....', '#....', '####.', '#...#', '#...#', '#...#', '#...#'],
};
const WORD = 'c9watch';
const ROWS = 7;
const pad = (g: string[]) => [...Array(ROWS - g.length).fill('.....'), ...g];
const glyphs = WORD.split('').map((ch) => pad(FONT[ch]));
// 5 columns per letter, 1 blank column between letters
const rows = Array.from({ length: ROWS }, (_, r) => glyphs.map((g) => g[r]).join('.'));
const COLS = rows[0].length;
const cells = rows.flatMap((row) => row.split('').map((c) => c === '#'));
const links = [
  { label: 'Install', href: '/install/' },
  { label: 'Features', href: '/features/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Compatibility', href: '/compatibility/' },
  { label: 'GitHub', href: 'https://github.com/minchenlee/c9watch', external: true },
  { label: 'MIT', href: 'https://github.com/minchenlee/c9watch/blob/main/LICENSE', external: true },
  { label: '@minchenlee', href: 'https://github.com/minchenlee', external: true },
];
---

<footer class="term" data-cols={COLS}>
  <div class="term-inner">
    <div class="term-bar">
      <span>c9watch: every agent session, one dashboard</span>
      <span aria-hidden="true">[EOF]</span>
    </div>
    <div class="term-art" role="img" aria-label="c9watch" style={`--cols:${COLS}`}>
      {cells.map((on) => <i class={on ? 'px on' : 'px'} aria-hidden="true"></i>)}
    </div>
    <ul class="term-meta">
      {links.map((l) => (
        <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
      ))}
      <li>Also by the author: <a href="https://rmdv.mclee.dev" target="_blank" rel="noopener">rmdv</a></li>
    </ul>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('.term');
  const glyphs = footer ? Array.from(footer.querySelectorAll<HTMLElement>('.px.on')) : [];
  // App status tokens: Working, Needs Attention, Ready
  const COLORS = ['#7928ca', '#ff6600', '#00ff88'];
  const LIT_MS = 1100;
  const TICK_MS = 160;

  function light(el: HTMLElement) {
    el.style.background = COLORS[(Math.random() * COLORS.length) | 0];
    window.setTimeout(() => { el.style.background = ''; }, LIT_MS);
  }

  if (footer && glyphs.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      // One static frame: a few fixed glyphs lit.
      [8, 31, 57, 83, 104].forEach((n, i) => {
        const el = glyphs[n % glyphs.length];
        el.style.background = COLORS[i % COLORS.length];
      });
    } else {
      let timer = 0;
      let inView = false;
      const tick = () => { for (let i = 0; i < 2; i++) light(glyphs[(Math.random() * glyphs.length) | 0]); };
      const sync = () => {
        const run = inView && !document.hidden;
        if (run && !timer) timer = window.setInterval(tick, TICK_MS);
        if (!run && timer) { clearInterval(timer); timer = 0; }
      };
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.1 }).observe(footer);
      document.addEventListener('visibilitychange', sync);
    }
  }
</script>

<style>
  .term {
    background: var(--bg-elevated, #0a0a0a);
    border-top: 1px solid var(--border-muted);
    padding: var(--section-y) 1.5rem 2.5rem;
  }

  .term-inner {
    max-width: 1000px;
    margin: 0 auto;
    font-family: var(--font-mono);
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-muted);
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .term-bar span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Square pixels: equal-width columns, every cell aspect-ratio 1 */
  .term-art {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2px;
    margin: 2.5rem 0;
  }

  .px {
    display: block;
    aspect-ratio: 1;
  }

  .px.on {
    background: #262626;
    transition: background-color 0.6s ease;
  }

  .term-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--text-muted);
  }

  .term-meta li {
    margin: 0;
    padding: 0;
  }

  .term-meta a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .term-meta a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .term {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .term-art {
      gap: 1px;
    }
  }
</style>
