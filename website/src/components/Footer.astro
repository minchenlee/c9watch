---
// website/src/components/Footer.astro
// LED-board footer: one canvas of square pixels. The c9watch wordmark is made of brighter
// cells; status colours (Working, Needs Attention, Ready) tick across the whole panel.
const links = [
  { label: 'Install', href: '/install/' },
  { label: 'Features', href: '/features/' },
  { label: 'Changelog', href: '/changelog/' },
  { label: 'Compatibility', href: '/compatibility/' },
  { label: 'GitHub', href: 'https://github.com/minchenlee/c9watch', external: true },
  { label: 'MIT', href: 'https://github.com/minchenlee/c9watch/blob/main/LICENSE', external: true },
  { label: '@minchenlee', href: 'https://github.com/minchenlee', external: true },
];
---

<footer class="term">
  <div class="term-pad term-bar">
    <span>c9watch: every agent session, one dashboard</span>
    <span aria-hidden="true">[EOF]</span>
  </div>
  <div class="term-panel">
    <canvas class="term-canvas" role="img" aria-label="c9watch"></canvas>
  </div>
  <ul class="term-pad term-meta">
    {links.map((l) => (
      <li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>
    ))}
    <li>Also by the author: <a href="https://rmdv.mclee.dev" target="_blank" rel="noopener">rmdv</a></li>
  </ul>
</footer>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.term-canvas');
  const panel = canvas?.parentElement;
  if (canvas && panel) {
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;

    // Tuned by the owner (c9-footer-tuner, engine ported from the r6 footer).
    const PARAMS = {
      cell: 5, gap: 1, stroke: 0, margin: 6, blur: 2,
      levels: 10, gMin: 15, gMax: 92, tint: 5, contrast: 0.82,
      sway: 0.15, swaySpeed: 2.8, fold: 0.26, ripple: 0.07, rippleSpeed: 0.6,
      gustSpeed: 0.6, gustCalm: 0.06, gustGain: 2.2, windDir: 1,
      erodeTries: 22, erodeBase: 0.015, erodeGust: 0.9, erodeDepth: 0.84, refillMin: 620, refillMax: 1800,
      grainSpeed: 1.5, grainSink: 2.55, grainTurb: 2.75, grainLife: 1250, grainMax: 600, grainBright: 0.85,
      tailAt: 0.55, tailGain: 0.28, tailLen: 3, dustFade: 380,
      pushMin: 9, pushMax: 18, pushAmp: 1.1, pushRadius: 40, pushDur: 1100,
      colorMax: 20, colorChance: 1, glowFade: 500,
      fps: 30,
    };
    const P = { ...PARAMS };
    const SMALL_CELL = 4;             // viewports <= 640px; drops to 3 if the word would lose its 2-cell side margins

    // 5-wide glyphs; c, w, a have 5 rows and sit on the baseline of the 7-row grid.
    const FONT: Record<string, string[]> = {
      c: ['.###.', '#...#', '#....', '#...#', '.###.'],
      '9': ['.###.', '#...#', '#...#', '.####', '....#', '#...#', '.###.'],
      w: ['#...#', '#...#', '#.#.#', '#.#.#', '.#.#.'],
      a: ['.###.', '....#', '.####', '#...#', '.####'],
      t: ['.#...', '.#...', '####.', '.#...', '.#...', '.#..#', '..##.'],
      h: ['#....', '#....', '####.', '#...#', '#...#', '#...#', '#...#'],
    };
    const GLYPH_ROWS = 7;
    const word = (() => {
      const base = 'c9watch'.split('').map((ch) => [...Array(GLYPH_ROWS - FONT[ch].length).fill('.....'), ...FONT[ch]]);
      return Array.from({ length: GLYPH_ROWS }, (_, r) => base.map((g) => g[r]).join('.'));
    })();
    const WORD_COLS = word[0].length; // 41

    // App status tokens: Working, Needs Attention, Ready
    const STATUS: [number, number, number][] = [[121, 40, 202], [255, 102, 0], [0, 255, 136]];
    const SS = 3; // field samples per cell

    let PALETTE: number[][] = [];
    let PAL_CSS: string[] = [];
    let S = 5, GAP = 1, PITCH = 6;
    let cols = 0, rows = 0, offX = 0, W = 0, H = 0, FW = 0, FH = 0;
    let field: Float32Array, glow: Float32Array, hue: Uint8Array, rate: Float32Array;
    let erode: Float32Array, erodeRate: Float32Array, dust: Float32Array;
    let edgeIdx: number[] = [], leeIdx: number[] = [];
    type Grain = { x: number; y: number; vx: number; vy: number; born: number; life: number; b: number; c: number };
    let grains: Grain[] = [];
    let push: { x: number; y: number; start: number; dur: number } | null = null;
    let nextPush = 0, nextColor = 0;
    let timer = 0, lastDraw = 0, lastFrame = 0, clock = 0;
    let perfSum = 0, perfN = 0, perfMax = 0;

    function palette() {
      PALETTE = Array.from({ length: P.levels }, (_, q) => {
        const t = P.levels > 1 ? q / (P.levels - 1) : 1;
        const g = P.gMin + t * (P.gMax - P.gMin);
        return [g - t * 2, g, g + 2 + t * P.tint];
      });
      PAL_CSS = PALETTE.map((p) => `rgb(${p[0] | 0},${p[1] | 0},${p[2] | 0})`);
    }

    function blur(src: Float32Array, dst: Float32Array, w: number, h: number, rad: number) {
      const inv = 1 / (2 * rad + 1);
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        let s = 0;
        for (let d = -rad; d <= rad; d++) s += src[y * w + Math.min(w - 1, Math.max(0, x + d))];
        dst[y * w + x] = s * inv;
      }
      for (let x = 0; x < w; x++) for (let y = 0; y < h; y++) {
        let s = 0;
        for (let d = -rad; d <= rad; d++) s += dst[Math.min(h - 1, Math.max(0, y + d)) * w + x];
        src[y * w + x] = s * inv;
      }
    }

    // Bilinear sample of the coverage field at a position given in cell units.
    function sample(fx: number, fy: number) {
      const u = Math.min(FW - 1.001, Math.max(0, fx * SS - 0.5));
      const v = Math.min(FH - 1.001, Math.max(0, fy * SS - 0.5));
      const x = u | 0, y = v | 0, a = u - x, b = v - y, i = y * FW + x;
      return (field[i] * (1 - a) + field[i + 1] * a) * (1 - b) + (field[i + FW] * (1 - a) + field[i + FW + 1] * a) * b;
    }

    function layout() {
      palette();
      const w = panel!.clientWidth;
      const small = w <= 640;
      S = small ? SMALL_CELL : P.cell;
      GAP = P.gap;
      PITCH = S + GAP;
      cols = Math.floor((w + GAP) / PITCH);
      if (small && cols < WORD_COLS + 4) { S = 3; PITCH = S + GAP; cols = Math.floor((w + GAP) / PITCH); }
      cols = Math.max(WORD_COLS + 2, cols);
      const k = P.stroke > 0 ? P.stroke : Math.max(1, Math.floor((cols - 4) / WORD_COLS));
      const wordW = WORD_COLS * k, wordH = GLYPH_ROWS * k;
      rows = wordH + P.margin * 2;
      W = Math.min(w, cols * PITCH - GAP);
      H = rows * PITCH - GAP;
      offX = (W - (cols * PITCH - GAP)) / 2;
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      canvas!.dataset.cell = `${S}`;
      canvas!.dataset.grid = `${cols}x${rows}`;

      FW = cols * SS; FH = rows * SS;
      field = new Float32Array(FW * FH);
      const tmp = new Float32Array(FW * FH);
      const x0 = Math.floor((cols - wordW) / 2), y0 = P.margin;
      for (let r = 0; r < GLYPH_ROWS; r++) for (let c = 0; c < WORD_COLS; c++) {
        if (word[r][c] !== '#') continue;
        const fx0 = (x0 + c * k) * SS, fy0 = (y0 + r * k) * SS;
        for (let y = fy0; y < fy0 + k * SS; y++) for (let x = fx0; x < fx0 + k * SS; x++) if (x >= 0 && x < FW) field[y * FW + x] = 1;
      }
      for (let n = 0; n < P.blur; n++) blur(field, tmp, FW, FH, 1);

      edgeIdx = []; leeIdx = [];
      const up = P.windDir > 0 ? -1 : 1; // windward neighbour column
      const cov = (c: number, r: number) => (c < 0 || r < 0 || c >= cols || r >= rows ? 0 : sample(c + 0.5, r + 0.5));
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        if (cov(c, r) > 0.55) {
          if (cov(c + up, r) < 0.35 || cov(c, r - 1) < 0.35) edgeIdx.push(r * cols + c);
          if (cov(c - up, r) < 0.35) leeIdx.push(r * cols + c);
        }
      }
      const n = cols * rows;
      glow = new Float32Array(n); hue = new Uint8Array(n); rate = new Float32Array(n);
      erode = new Float32Array(n); erodeRate = new Float32Array(n); dust = new Float32Array(n);
      grains = []; push = null;
    }

    // Irregular gust, 0..1: two slow waves multiplied, so calm spells and strong spells alternate.
    function gustAt(t: number, c: number) {
      const s = P.gustSpeed;
      const a = 0.5 + 0.5 * Math.sin(t * 0.001 * s);
      const b = 0.5 + 0.5 * Math.sin(t * 0.00218 * s + 2);
      const g = Math.min(1, Math.max(0, (a * b - P.gustCalm) * P.gustGain));
      return g * (0.65 + 0.35 * Math.sin(c * 0.05 * P.windDir - t * 0.0008 * s));
    }

    function spawnGrain(i: number, t: number, g: number, colored: number) {
      if (grains.length >= P.grainMax) return;
      erode[i] = Math.max(erode[i], 0.5 + Math.random() * 0.5);
      const lo = Math.min(P.refillMin, P.refillMax), hi = Math.max(P.refillMin, P.refillMax);
      erodeRate[i] = 1 / (lo + Math.random() * (hi - lo));
      grains.push({
        x: i % cols, y: Math.floor(i / cols),
        vx: P.windDir * (0.004 + Math.random() * 0.008) * (0.5 + g) * P.grainSpeed,
        vy: (0.0015 + Math.random() * 0.002) * P.grainSink,
        born: t, life: P.grainLife * (0.56 + Math.random() * 0.88), b: P.grainBright * (0.9 + Math.random() * 0.2), c: colored,
      });
    }

    function bigGust(now: number) {
      if (!edgeIdx.length) return;
      const i = edgeIdx[(Math.random() * edgeIdx.length) | 0];
      push = { x: i % cols, y: Math.floor(i / cols), start: now, dur: P.pushDur };
    }

    function step(now: number, dt: number) {
      for (let i = 0; i < glow.length; i++) {
        if (glow[i] > 0) glow[i] = Math.max(0, glow[i] - rate[i] * dt);
        if (erode[i] > 0) erode[i] = Math.max(0, erode[i] - erodeRate[i] * dt);
        if (dust[i] > 0) dust[i] = Math.max(0, dust[i] - dt / P.dustFade);
      }
      let coloredNow = 0;
      for (const gr of grains) if (gr.c >= 0) coloredNow++;
      if (edgeIdx.length) for (let n = 0; n < P.erodeTries; n++) {
        const i = edgeIdx[(Math.random() * edgeIdx.length) | 0];
        const g = gustAt(now, i % cols);
        if (Math.random() < P.erodeBase + P.erodeGust * g * g) {
          const want = coloredNow < P.colorMax && now >= nextColor && Math.random() < P.colorChance;
          if (want) { nextColor = now + 500 + Math.random() * 1200; coloredNow++; }
          spawnGrain(i, now, g, want ? (Math.random() * STATUS.length) | 0 : -1);
        }
      }
      const gl = gustAt(now, cols / 2);
      if (gl > P.tailAt && leeIdx.length) for (let n = 0; n < 4; n++) {
        const i = leeIdx[(Math.random() * leeIdx.length) | 0];
        const len = 1 + ((Math.random() * P.tailLen) | 0);
        for (let d = 1; d <= len; d++) {
          const j = i + d * P.windDir;
          if (j >= 0 && j < dust.length) dust[j] = Math.max(dust[j], P.tailGain * gl * (1 - d / (len + 1)));
        }
      }
      grains = grains.filter((gr) => {
        const age = now - gr.born;
        if (age > gr.life) return false;
        const g = gustAt(now, gr.x);
        gr.x += gr.vx * dt * (0.6 + g);
        gr.y += (gr.vy + 0.003 * P.grainTurb * Math.sin(age * 0.012 + gr.x)) * dt;
        const cx = Math.round(gr.x), cy = Math.round(gr.y);
        if (cx >= 0 && cx < cols && cy >= 0 && cy < rows) {
          const i = cy * cols + cx, f = 1 - age / gr.life;
          if (gr.c >= 0) { if (f * 0.9 > glow[i]) { glow[i] = f * 0.9; hue[i] = gr.c; rate[i] = 1 / P.glowFade; } }
          else dust[i] = Math.max(dust[i], Math.min(1, gr.b * f));
        }
        return true;
      });
      if (!push && now >= nextPush) {
        if (nextPush > 0) bigGust(now);
        const lo = Math.min(P.pushMin, P.pushMax), hi = Math.max(P.pushMin, P.pushMax);
        nextPush = now + (lo + Math.random() * (hi - lo)) * 1000;
      }
      if (push && now - push.start > push.dur) push = null;
    }

    function draw(now: number) {
      ctx.clearRect(0, 0, W, H);
      const top = P.levels - 1;
      const pEnv = push ? Math.sin(((now - push.start) / push.dur) * Math.PI) : 0;
      const sw = P.swaySpeed * 0.001, rs = P.rippleSpeed * 0.001;
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        let dx = P.sway * Math.sin(r * 0.3 + now * sw);
        if (push) { const ddx = c - push.x, ddy = r - push.y; dx -= P.windDir * P.pushAmp * pEnv * Math.exp(-(ddx * ddx + ddy * ddy) / P.pushRadius); }
        const cov = sample(c + 0.5 + dx, r + 0.5);
        const i = r * cols + c;
        const fold = P.fold * Math.sin(c * 0.1 + r * 0.08 - now * 0.0007);
        const rip = 0.5 + 0.5 * Math.sin(c * 0.07 * P.windDir + r * 0.11 - now * rs);
        let v = cov * (P.contrast + fold) + (1 - cov) * rip * P.ripple - erode[i] * P.erodeDepth * cov + dust[i] * 0.6;
        v = v < 0 ? 0 : v > 1 ? 1 : v;
        const q = Math.round(v * top), a = glow[i];
        if (a > 0) {
          const k = a * a * (3 - 2 * a), p = PALETTE[q], s = STATUS[hue[i]];
          ctx.fillStyle = `rgb(${(p[0] + (s[0] - p[0]) * k) | 0},${(p[1] + (s[1] - p[1]) * k) | 0},${(p[2] + (s[2] - p[2]) * k) | 0})`;
        } else ctx.fillStyle = PAL_CSS[q];
        ctx.fillRect(offX + c * PITCH, r * PITCH, S, S);
      }
    }

    function frame(ts: number) {
      timer = requestAnimationFrame(frame);
      if (ts - lastDraw < 1000 / P.fps) return;
      const dt = Math.min(100, lastFrame ? ts - lastFrame : 33);
      lastFrame = ts; lastDraw = ts;
      clock += dt;
      const t0 = performance.now();
      step(clock, dt);
      draw(clock);
      const cost = performance.now() - t0;
      perfSum += cost; perfN++; perfMax = Math.max(perfMax, cost);
      canvas!.dataset.perf = `${(perfSum / perfN).toFixed(2)}ms avg, ${perfMax.toFixed(2)}ms max, n=${perfN}`;
    }

    function staticFrame() {
      // one settled frame: a few eroded edge cells and a little dust downwind of them
      if (!edgeIdx.length) { draw(4000); return; }
      for (let n = 0; n < 12; n++) {
        const i = edgeIdx[Math.floor(((n + 0.5) / 12) * edgeIdx.length)];
        erode[i] = 0.7;
        for (let d = 1; d <= 3; d++) { const j = i + d * P.windDir; if (j >= 0 && j < dust.length) dust[j] = 0.6 - d * 0.15; }
      }
      [0.2, 0.5, 0.8].forEach((f, n) => {
        const i = edgeIdx[Math.floor(f * edgeIdx.length)] + 4 * P.windDir;
        if (i >= 0 && i < glow.length) { glow[i] = 0.85; hue[i] = n % STATUS.length; }
      });
      draw(4000);
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;
    const sync = () => {
      const run = !reduced && inView && !document.hidden;
      if (run && !timer) { lastFrame = 0; timer = requestAnimationFrame(frame); }
      if (!run && timer) { cancelAnimationFrame(timer); timer = 0; }
    };

    layout();
    if (reduced) staticFrame(); else draw(0);

    // Keep bitmap size, grid and CSS size in sync when the panel width changes (same fix as DotGrid).
    let lastW = panel.clientWidth;
    let resizeTimer: ReturnType<typeof setTimeout>;
    new ResizeObserver(() => {
      if (panel.clientWidth === lastW) return;
      lastW = panel.clientWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        layout();
        if (reduced) staticFrame(); else draw(clock);
      }, 100);
    }).observe(panel);

    if (!reduced) {
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        sync();
      }, { threshold: 0.1 }).observe(panel);
      document.addEventListener('visibilitychange', sync);
    }
  }
</script>

<style>
  .term {
    background: var(--bg-elevated, #0a0a0a);
    border-top: 1px solid var(--border-muted);
    padding: var(--section-y) 0 2.5rem;
    font-family: var(--font-mono);
  }

  .term-pad {
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    box-sizing: content-box;
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .term-bar span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .term-panel {
    width: 100%;
    margin: 1rem 0 1.75rem;
    line-height: 0;
  }

  .term-canvas {
    display: block;
  }

  .term-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    margin-top: 0;
    margin-bottom: 0;
    list-style: none;
    font-size: 12px;
    color: var(--text-muted);
  }

  .term-meta li {
    margin: 0;
    padding: 0;
  }

  .term-meta a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .term-meta a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .term-pad {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
