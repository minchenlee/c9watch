---
// website/src/components/Features.astro
const features = [
  {
    title: 'Auto-discovery',
    description: 'Detects running Claude Code, Codex, Cursor Agent and Pi sessions automatically. No plugins, no setup.',
    image: '/screenshots/monitor-tab.png',
  },
  {
    title: 'Real-time status',
    description: 'See at a glance which sessions are Working, Need Attention, or Ready. Sessions that wait for you surface first.',
    image: '/screenshots/monitor-tab.png',
  },
  {
    title: 'Session history',
    description: 'Browse and search all past sessions with instant metadata filter and deep content search.',
    image: '/screenshots/history-tab.png',
  },
  {
    title: 'Cost tracker',
    description: 'Daily, per-project, and per-model spending across your Claude Code, Codex and Pi sessions.',
    image: '/screenshots/cost-tab.png',
  },
  {
    title: 'Tray popover',
    description: 'Click the menu bar icon for a quick-glance overlay of session status.',
    image: '/screenshots/tray-popover.jpeg',
  },
  {
    title: 'Conversation viewer',
    description: 'Expand any session to see the full conversation with formatted markdown, code blocks, and inline images.',
    image: '/screenshots/conversation-viewer.png',
  },
  {
    title: 'Memory viewer',
    description: 'Browse and inspect memory files in a two-panel layout with quick access to Claude commands.',
    image: '/screenshots/memory-tab.png',
  },
  {
    title: 'Token distance',
    description: 'Visualize your token usage as a rice stack towering past 17 real-world landmarks. Share as an Instagram-ready PNG.',
    image: '/screenshots/token-distance-visualizer.png',
  },
  {
    title: 'CLI for agents',
    description: 'Scriptable session management with JSON output. List, view, search, watch, and stop sessions from other coding agents or scripts.',
  },
];
---

<section class="features">
  <h2 class="features-heading">Features</h2>
  <div class="features-grid">
    {features.map(f => (
      <div class="feature-card">
        <h3 class="feature-title">{f.title}</h3>
        <p class="feature-desc">{f.description}</p>
        {f.image && (
          <div class="feature-img">
            <img src={f.image} alt={f.title} loading="lazy" />
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .features {
    position: relative;
    padding: 4rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    border-top: 1px solid var(--border-muted);
    /* Subtle grid background */
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .features-heading {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    padding: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .feature-card:hover {
    border-color: var(--border-focus);
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    color: var(--text-secondary);
    font-size: 14px;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .feature-img {
    border: 1px solid var(--border-muted);
    overflow: hidden;
  }

  .feature-img img {
    width: 100%;
    display: block;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
