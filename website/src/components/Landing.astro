---
import Hero from './Hero.astro';
import Compatibility from './Compatibility.astro';
import Features from './Features.astro';
import TechStack from './TechStack.astro';
import InstallCTA from './InstallCTA.astro';
import FAQ from './FAQ.astro';
import Footer from './Footer.astro';
import DotGrid from './DotGrid.astro';
---

<div class="landing-wrapper">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "c9watch",
    "description": "A free, open-source macOS desktop app that provides a real-time dashboard for monitoring your Claude Code, Codex, Cursor Agent and Pi sessions across different projects.",
    "url": "https://c9watch.mclee.dev",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS, Linux (CLI only)",
    "license": "https://opensource.org/licenses/MIT",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "author": {
      "@type": "Person",
      "name": "Min-Chen Lee",
      "url": "https://github.com/minchenlee"
    },
    "sameAs": [
      "https://github.com/minchenlee/c9watch"
    ],
    "downloadUrl": "https://github.com/minchenlee/c9watch/releases",
    "screenshot": "https://c9watch.mclee.dev/og-image.png"
  })} />
  <nav class="c9-nav">
    <a href="/" class="c9-nav-logo">
      <img src="/icon-48.png" alt="c9watch" width="24" height="24" />
      <span>c9watch</span>
    </a>
    <div class="c9-nav-links">
      <a href="/features/" class="c9-nav-text">Features</a>
      <a href="/changelog/" class="c9-nav-text">Changelog</a>
      <a href="https://github.com/minchenlee/c9watch" target="_blank" rel="noopener" class="c9-nav-gh">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279L12 19.446l-7.416 3.967 1.48-8.279L0 9.306l8.332-1.151z"></path></svg>
        GitHub
      </a>
      <a href="/install/" class="c9-nav-download">Download</a>
    </div>
  </nav>
  <div class="hero-wrapper">
    <DotGrid />
    <Hero />
  </div>
  <div class="fade-in"><Compatibility /></div>
  <div class="fade-in"><Features /></div>
  <div class="fade-in"><TechStack /></div>
  <div class="fade-in"><InstallCTA /></div>
  <div class="fade-in"><FAQ /></div>
  <Footer />
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>

<style>
  .landing-wrapper {
    margin: 0 auto;
  }

  .c9-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 1.5rem;
    background: var(--bg-base);
    border-bottom: 1px solid var(--border-muted);
    backdrop-filter: blur(12px);
  }

  .c9-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .c9-nav-logo:hover {
    text-decoration: none;
  }

  .c9-nav-logo img {
    border-radius: 6px;
  }

  .c9-nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .c9-nav-links a {
    color: var(--text-secondary);
    font-size: 14px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .c9-nav-links a:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .c9-nav-links {
    align-items: center;
  }

  .c9-nav-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .c9-nav-links a.c9-nav-download {
    padding: 0.35rem 0.9rem;
    background: var(--text-primary);
    color: var(--bg-base);
    font-weight: 500;
  }

  .c9-nav-links a.c9-nav-download:hover {
    color: var(--bg-base);
    background: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .c9-nav {
      padding: 0 1rem;
    }

    .c9-nav-links {
      gap: 1rem;
    }

    .c9-nav-text {
      display: none;
    }
  }

  .hero-wrapper {
    position: relative;
    overflow: hidden;
  }
</style>
