{
  "$defs": {
    "AgentCreateParams": {
      "description": "`agent.create` params. C1a creates only free agents (A:794): no brief,\nno worktree, the given cwd.",
      "properties": {
        "cwd": {
          "description": "An absolute directory. The engine uses its realpath.",
          "type": "string"
        },
        "kind": {
          "default": "claude",
          "description": "The adapter kind. Only `claude` in C1a.",
          "type": "string"
        },
        "mode": {
          "description": "`free`. `managed` comes in C1b and answers `unsupported_in_c1a`.",
          "type": "string"
        },
        "name": {
          "description": "A display name: letters, digits, `.`, `_` and `-`, unique among\nthe live engine agents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "mode",
        "cwd"
      ],
      "type": "object"
    },
    "AgentCreateResult": {
      "description": "`agent.create` result: the agent once it is `ready`.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRow"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentListParams": {
      "description": "`agent.list` params.",
      "properties": {
        "all": {
          "default": false,
          "description": "Also return gone, retired and failed agents (tombstones included).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "AgentListResult": {
      "description": "`agent.list` result, in creation order.",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentRow"
          },
          "type": "array"
        }
      },
      "required": [
        "agents"
      ],
      "type": "object"
    },
    "AgentRetireParams": {
      "description": "`agent.retire` params.",
      "properties": {
        "id": {
          "description": "The agent id (`agt_<ulid>`).",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "AgentRetireResult": {
      "description": "`agent.retire` result: the tombstone row (A:828). Retiring a retired or\nfailed agent changes nothing and returns its row.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentRow"
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    },
    "AgentRow": {
      "description": "One row of the `agents` table (A:340), as `snapshot.get`,\n`session.list` and `agent.list` send it.",
      "properties": {
        "control": {
          "description": "`pty` or `none`.",
          "type": "string"
        },
        "createdAt": {
          "description": "Unix ms.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "createdBy": {
          "description": "The principal that created the agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "description": "The working directory; for an observed agent, the project path.",
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "description": "+1 on spawn, resume, refresh and takeover.",
          "format": "int64",
          "type": "integer"
        },
        "goneAt": {
          "description": "Unix ms; `null` while the agent is alive.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "`agt_<ulid>`.",
          "type": "string"
        },
        "interruptedNotePending": {
          "type": "boolean"
        },
        "lastSeen": {
          "description": "Unix ms of a detection tick that saw the agent. While nothing else\nin the row changes, it moves at most once a minute.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "machineId": {
          "description": "The machine the agent runs on.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "description": "`managed` or `free`; `null` for an observed agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "description": "The agent that owns this one; for an imported legacy worker, the PM\nthat adopted it.",
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "provider": {
          "description": "The adapter kind: `claude`, `codex`, ...",
          "type": "string"
        },
        "providerSid": {
          "description": "The provider session id of the current generation.",
          "type": [
            "string",
            "null"
          ]
        },
        "resumeCount": {
          "format": "int64",
          "type": "integer"
        },
        "role": {
          "description": "`human`, `orch`, `worker` or `observed`.",
          "type": "string"
        },
        "sessionKey": {
          "description": "`SessionIdentity::key()` (`<provider>:<session id>`) of the session\ndetection matched to this agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "`detected`, `engine` or `legacy_import`.",
          "type": "string"
        },
        "startedAt": {
          "description": "Unix ms, as the provider reports it.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "description": "Engine lifecycle state (`creating`, `starting`, `ready`, `working`,\n`blocked`, `paused`, `refreshing`, `interrupted`, `retiring`,\n`retired`, `failed`, `orphaned`); `null` for an observed agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "The detected session status: `working`, `needs_attention`,\n`waiting_for_input` or `connecting`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "generation",
        "mode",
        "role",
        "control",
        "provider",
        "providerSid",
        "source",
        "createdBy",
        "goneAt",
        "resumeCount",
        "interruptedNotePending",
        "sessionKey",
        "machineId",
        "state",
        "status",
        "cwd",
        "name",
        "pid",
        "startedAt",
        "createdAt",
        "lastSeen",
        "parentId"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "description": "What a client says about itself in `hello`. Unverified.",
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ErrorBody": {
      "description": "The `error` object of a failed response.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "hint": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "msg",
        "retryable",
        "hint"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "Typed error codes. New codes are additive; a client that does not know a\ncode still has `msg`, `retryable` and `hint`.",
      "oneOf": [
        {
          "const": "upgrade_required",
          "description": "The client speaks another major version.",
          "type": "string"
        },
        {
          "const": "hello_required",
          "description": "The first frame was not `hello`.",
          "type": "string"
        },
        {
          "const": "hello_timeout",
          "description": "No `hello` arrived in time.",
          "type": "string"
        },
        {
          "const": "frame_too_large",
          "description": "A frame is larger than `MAX_FRAME`.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "The frame is not valid JSON or misses a required field.",
          "type": "string"
        },
        {
          "const": "unknown_method",
          "description": "The engine has no such method.",
          "type": "string"
        },
        {
          "const": "peer_uid_mismatch",
          "description": "The peer runs under another uid.",
          "type": "string"
        },
        {
          "const": "cursor_expired",
          "description": "The cursor's events are gone: pruned, another epoch or machine, or\nahead of the log.",
          "type": "string"
        },
        {
          "const": "rate_limited",
          "description": "The caller is over a limit, such as the event streams per\nconnection.",
          "type": "string"
        },
        {
          "const": "peer_not_authorized",
          "description": "A hook-class method (`hook.*`, `task.done`, `agent.handoff`) from a\ncaller that is not a live agent running the engine's own\n`c9watch-agent` copy, or that names another agent.",
          "type": "string"
        },
        {
          "const": "no_task",
          "description": "`task.done` from an agent without a task (every free agent).",
          "type": "string"
        },
        {
          "const": "unsupported_in_c1a",
          "description": "The method is part of the wire format but does nothing before C1b\n(`agent.handoff`).",
          "type": "string"
        },
        {
          "const": "agent_bin_missing",
          "description": "The engine has no `c9watch-agent` copy: none was next to the engine\nbinary when it started, or the copy is gone.",
          "type": "string"
        },
        {
          "const": "agent_bin_mismatch",
          "description": "The engine's `c9watch-agent` copy no longer has the sha256 it had\nwhen the engine installed it.",
          "type": "string"
        },
        {
          "const": "experimental_disabled",
          "description": "`agent.create` while the engine runs without\n`C9WATCH_EXPERIMENTAL_CREATE=1` (C1a).",
          "type": "string"
        },
        {
          "const": "not_allowed",
          "description": "The principal may not call this method (`agent.create` and\n`agent.retire` take only a local client in C1a).",
          "type": "string"
        },
        {
          "const": "cwd_collision",
          "description": "The canonical cwd of a free agent is inside the engine home or a\nmanaged worktree home.",
          "type": "string"
        },
        {
          "const": "spawn_failed",
          "description": "The agent process exited, showed a vendor refusal (usage limit,\nlogin) or was not ready in time. The engine does not retry.",
          "type": "string"
        },
        {
          "const": "unknown_agent",
          "description": "No engine agent has this id.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "An engine-side failure.",
          "type": "string"
        }
      ]
    },
    "EventFrame": {
      "description": "One event on the wire (A:203). `sub` is the `id` of the subscribe\nrequest, so a connection can carry several subscriptions.",
      "properties": {
        "cursor": {
          "type": "string"
        },
        "data": true,
        "origin": true,
        "sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "type": "string"
        },
        "ts": {
          "format": "int64",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "v": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "cursor",
        "topic",
        "ts",
        "data"
      ],
      "type": "object"
    },
    "EventType": {
      "description": "The `type` of an event frame. A response frame has no `type`, so a\nclient tells the two apart by `type === \"event\"`.",
      "enum": [
        "event"
      ],
      "type": "string"
    },
    "HandoffParams": {
      "description": "`agent.handoff` params (`c9watch-agent handoff --note -`). The wire\nformat is fixed now; the engine answers `unsupported_in_c1a` until C1b.",
      "properties": {
        "agentId": {
          "description": "`C9_AGENT_ID` of the sender.",
          "type": "string"
        },
        "note": {
          "description": "What the next generation should know.",
          "type": "string"
        },
        "seq": {
          "description": "The sender's clock in ns, as a string.",
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "note",
        "seq"
      ],
      "type": "object"
    },
    "HandoffResult": {
      "description": "`agent.handoff` result (C1b).",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted"
      ],
      "type": "object"
    },
    "HelloParams": {
      "description": "`hello` params. `client` is the caller's own claim. The engine only logs\nit as unverified; it never decides the principal (N1).",
      "properties": {
        "apiMajor": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "want": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "HelloResult": {
      "description": "`hello` result.",
      "properties": {
        "apiMajor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "apiMinor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cursor": {
          "description": "Cursor of the newest committed event. `null` only without a store.",
          "type": [
            "string",
            "null"
          ]
        },
        "engineVersion": {
          "type": "string"
        },
        "machineId": {
          "type": "string"
        },
        "principal": {
          "description": "Stamped by the engine from connection facts.",
          "type": "string"
        }
      },
      "required": [
        "apiMajor",
        "apiMinor",
        "engineVersion",
        "machineId",
        "principal",
        "capabilities",
        "cursor"
      ],
      "type": "object"
    },
    "HookParams": {
      "description": "`hook.*` params: one Claude Code hook event, sent by `c9watch-agent\nhook <event>`. The engine alone writes the log (A:1167).",
      "properties": {
        "agentId": {
          "description": "`C9_AGENT_ID` of the sender. It must be the agent the engine stamped.",
          "type": "string"
        },
        "input": {
          "default": null,
          "description": "The hook's stdin JSON as the vendor sent it; `null` when it was not\nJSON or too large."
        },
        "kind": {
          "description": "The adapter kind of the hook (`claude`). The engine compares it with\nthe agent row (A:1056).",
          "type": "string"
        },
        "seq": {
          "description": "The sender's clock in ns, as a string. With `agentId` it dedupes.",
          "type": "string"
        },
        "truncated": {
          "description": "The stdin JSON was larger than the hook forwards.",
          "type": "boolean"
        }
      },
      "required": [
        "agentId",
        "kind",
        "seq"
      ],
      "type": "object"
    },
    "HookResult": {
      "description": "`hook.*` result.",
      "properties": {
        "accepted": {
          "description": "The engine took the event. A dropped event (an old generation, a\nduplicate) still gets `ok:true`, with `accepted:false`.",
          "type": "boolean"
        },
        "additionalContext": {
          "description": "For `hook.session_start`: context the hook prints as\n`hookSpecificOutput.additionalContext`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "accepted"
      ],
      "type": "object"
    },
    "Request": {
      "description": "A request frame. Every field is optional on the wire, so that a frame\nwith a missing field still gets an error that echoes its `id`.",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idem": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": true,
        "v": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Response": {
      "description": "A response frame: `ok:true` with `result`, or `ok:false` with `error`.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "result": true,
        "seq": {
          "description": "Cursor of the event this write produced (from M2).",
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "v",
        "ok"
      ],
      "type": "object"
    },
    "SessionListParams": {
      "description": "`session.list` params. There are none yet; the engine ignores any it\ngets.",
      "type": "object"
    },
    "SessionListResult": {
      "description": "`session.list` result: the agents whose session detection sees now\n(`goneAt` is `null`), in creation order.",
      "properties": {
        "sessions": {
          "items": {
            "$ref": "#/$defs/AgentRow"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "SnapshotParams": {
      "description": "`snapshot.get` params. There are none yet; the engine ignores any it\ngets.",
      "type": "object"
    },
    "SnapshotResult": {
      "description": "`snapshot.get` result: the state and the cursor it is consistent with.\nSubscribing with `since` = `cursor` continues with no gap.",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentRow"
          },
          "type": "array"
        },
        "cursor": {
          "type": "string"
        },
        "machineId": {
          "type": "string"
        }
      },
      "required": [
        "cursor",
        "machineId",
        "agents"
      ],
      "type": "object"
    },
    "SubscribeParams": {
      "description": "`events.subscribe` params (A:218). Empty filters match everything.",
      "properties": {
        "since": {
          "description": "The last cursor the client has seen. Without it, the stream starts at\nthe current head.",
          "type": [
            "string",
            "null"
          ]
        },
        "subjects": {
          "description": "Exact subjects.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "topics": {
          "description": "Exact topics, or a prefix ending in `.*` (`agent.*`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SubscribeResult": {
      "description": "`events.subscribe` result. Event frames follow it on the same\nconnection until the connection closes, or until an error frame with\nthe subscribe request's `id` (`cursor_expired` when the subscriber fell\nbehind retention).",
      "properties": {
        "cursor": {
          "description": "Where the stream starts: events after this cursor follow.",
          "type": "string"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object"
    },
    "TaskDoneParams": {
      "description": "`task.done` params (`c9watch-agent task done --report`).",
      "properties": {
        "agentId": {
          "description": "`C9_AGENT_ID` of the sender.",
          "type": "string"
        },
        "report": {
          "type": "string"
        },
        "seq": {
          "description": "The sender's clock in ns, as a string.",
          "type": "string"
        }
      },
      "required": [
        "agentId",
        "report",
        "seq"
      ],
      "type": "object"
    },
    "TaskDoneResult": {
      "description": "`task.done` result. In C1a every agent is free, so the call fails with\n`no_task` instead.",
      "properties": {
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "taskId"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "apiMajor": 1,
  "apiMinor": 3,
  "description": "The c9watch engine protocol: one JSON object per line over the engine socket. Within a major version every change is additive.",
  "frames": {
    "event": {
      "$ref": "#/$defs/EventFrame"
    },
    "request": {
      "$ref": "#/$defs/Request"
    },
    "response": {
      "$ref": "#/$defs/Response"
    }
  },
  "methods": {
    "agent.create": {
      "params": {
        "$ref": "#/$defs/AgentCreateParams"
      },
      "result": {
        "$ref": "#/$defs/AgentCreateResult"
      }
    },
    "agent.handoff": {
      "params": {
        "$ref": "#/$defs/HandoffParams"
      },
      "result": {
        "$ref": "#/$defs/HandoffResult"
      }
    },
    "agent.list": {
      "params": {
        "$ref": "#/$defs/AgentListParams"
      },
      "result": {
        "$ref": "#/$defs/AgentListResult"
      }
    },
    "agent.retire": {
      "params": {
        "$ref": "#/$defs/AgentRetireParams"
      },
      "result": {
        "$ref": "#/$defs/AgentRetireResult"
      }
    },
    "events.subscribe": {
      "events": {
        "$ref": "#/$defs/EventFrame"
      },
      "params": {
        "$ref": "#/$defs/SubscribeParams"
      },
      "result": {
        "$ref": "#/$defs/SubscribeResult"
      }
    },
    "hello": {
      "params": {
        "$ref": "#/$defs/HelloParams"
      },
      "result": {
        "$ref": "#/$defs/HelloResult"
      }
    },
    "hook.notification": {
      "params": {
        "$ref": "#/$defs/HookParams"
      },
      "result": {
        "$ref": "#/$defs/HookResult"
      }
    },
    "hook.permission_denied": {
      "params": {
        "$ref": "#/$defs/HookParams"
      },
      "result": {
        "$ref": "#/$defs/HookResult"
      }
    },
    "hook.permission_request": {
      "params": {
        "$ref": "#/$defs/HookParams"
      },
      "result": {
        "$ref": "#/$defs/HookResult"
      }
    },
    "hook.session_start": {
      "params": {
        "$ref": "#/$defs/HookParams"
      },
      "result": {
        "$ref": "#/$defs/HookResult"
      }
    },
    "hook.stop": {
      "params": {
